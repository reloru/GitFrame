{
  "name": "gitframe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mobile-first video frame extractor that runs entirely in the browser.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.121.0"
  }
}
