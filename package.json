{
  "name": "gitframe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mobile-first video frame extractor that runs entirely in the browser.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^2.1.8",
    "esbuild": "^0.24.2",
    "eslint": "^9.18.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8",
    "wrangler": "^3.101.0"
  }
}
