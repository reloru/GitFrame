{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gitframe",
  "main": "worker/index.ts",
  "compatibility_date": "2025-01-15",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
